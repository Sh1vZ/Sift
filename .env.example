# Sift — local environment
#
# Copy this file to `.env` (git-ignored) and fill in what you need. Every
# variable is optional; an empty value means "use the default".
#
# How electron-vite exposes these:
#   MAIN_VITE_*      → main process      (import.meta.env.MAIN_VITE_*)
#   PRELOAD_VITE_*   → preload script
#   RENDERER_VITE_*  → renderer (the Vue app)
#   VITE_*           → all three
# Values are inlined when `npm run dev` / `npm run build` starts, so restart
# the dev server after editing. Anything without one of those prefixes is
# NOT visible to the app.

# ── Development ────────────────────────────────────────────────────────────

# Run against an isolated profile (its own library.db, thumbnail cache and
# single-instance lock) instead of %APPDATA%\sift. Lets you test a build next
# to a running install without touching its library. Dev builds only.
# Example: MAIN_VITE_USER_DATA_DIR=D:\sift-dev-profile
MAIN_VITE_USER_DATA_DIR=

# Open Chromium DevTools (detached) as soon as the window appears. Dev only.
MAIN_VITE_OPEN_DEVTOOLS=false

# Exercise the auto-updater in `npm run dev`. Off by default because a dev build
# has no update feed, so the updater stays inert and the UI reports it. Turn it on
# together with a `dev-app-update.yml` in the project root pointing at a static
# server holding a newer build's installer, .blockmap and beta.yml:
#
#   provider: generic
#   url: http://localhost:8080
#   channel: beta
#
# Note that "install" then really does run that installer. Dev only.
MAIN_VITE_UPDATER_DEV=false

# ── Runtime (shell environment, works for packaged builds too) ─────────────
#
# The same profile override, read from the process environment at launch —
# set it in the shell or a shortcut rather than in this file, e.g.
#   PowerShell:  $env:SIFT_USER_DATA = "D:\sift-test"; npm run dev
#   Git Bash:    SIFT_USER_DATA=/d/sift-test npm run dev
# (Listed here for reference only; electron-vite does not forward it from .env.)
# SIFT_USER_DATA=
