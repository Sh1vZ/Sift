{
  "name": "sift",
  "version": "1.0.0-beta.6",
  "description": "A local-first clip library for NVIDIA ShadowPlay and other game recordings",
  "main": "./out/main/index.js",
  "author": "ShivZ",
  "repository": "https://github.com/Sh1vZ/Sift",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:unpack": "npm run build && electron-builder --dir --config electron-builder.yml",
    "release": "esbuild scripts/release.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/scripts/release.cjs --log-level=warning && node out/scripts/release.cjs",
    "release:notes": "esbuild scripts/release-notes.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/scripts/release-notes.cjs --log-level=warning && node out/scripts/release-notes.cjs",
    "release:win": "npm run build && electron-builder --win --config electron-builder.yml --publish always",
    "release:ci": "electron-vite build && electron-builder --win --config electron-builder.yml --publish always",
    "test": "npm run test:store && npm run test:youtube && npm run test:clipboard && npm run test:icon",
    "test:store": "esbuild tests/store.test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/store.cjs --log-level=warning && node --no-warnings out/test/store.cjs",
    "test:youtube": "esbuild tests/youtube.test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/youtube.cjs --log-level=warning && node --no-warnings out/test/youtube.cjs",
    "test:clipboard": "esbuild tests/clipboard.test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/clipboard.cjs --log-level=warning && node --no-warnings out/test/clipboard.cjs",
    "test:icon": "esbuild tests/icon.test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/icon.cjs --log-level=warning && node --no-warnings out/test/icon.cjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@iconify-json/lucide": "^1.2.129",
    "@nuxt/ui": "^4.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "gsap": "^3.15.0",
    "motion-v": "^2.4.0",
    "ogl": "^1.0.11",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
