{
  "name": "sift",
  "version": "1.0.0-beta.2",
  "description": "A local-first clip library for NVIDIA ShadowPlay and other game recordings",
  "main": "./out/main/index.js",
  "author": "ShivZ",
  "repository": "https://github.com/Sh1vZ/Sift",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:unpack": "npm run build && electron-builder --dir --config electron-builder.yml",
    "release": "esbuild scripts/release.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/scripts/release.cjs --log-level=warning && node out/scripts/release.cjs",
    "release:notes": "esbuild scripts/release-notes.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/scripts/release-notes.cjs --log-level=warning && node out/scripts/release-notes.cjs",
    "release:win": "npm run build && electron-builder --win --config electron-builder.yml --publish always",
    "test": "esbuild tests/store.test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out/test/store.cjs --log-level=warning && node --no-warnings out/test/store.cjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-json/lucide": "^1.2.129",
    "@nuxt/ui": "^4.11.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "motion-v": "^2.4.0",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
